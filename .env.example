# Copy this file to .env and fill in real values. Never commit your actual .env file.

PORT=5000

# MongoDB connection string, e.g. mongodb://127.0.0.1:27017/beyond-the-resume
# or a MongoDB Atlas connection string.
MONGODB_URI=

# Required for login/signup token signing. Use a long, random secret.
JWT_SECRET=

# Optional: enables real AI-generated analysis via the Anthropic API.
# If left blank, the app automatically uses a deterministic fallback analysis.
AI_API_KEY=

# Optional: raises GitHub API rate limits and allows access to repos the
# token can see. Create one at https://github.com/settings/tokens
# (repo:read scope is sufficient for public repos; no scope needed for
# public-only access, but a token still raises the rate limit).
GITHUB_TOKEN=
